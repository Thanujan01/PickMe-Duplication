# ---------------------------------------------------------------------------
# Build-time configuration for the public GitHub Pages deployment.
#
# WHY THESE ARE COMMITTED, DELIBERATELY:
# Both values below are public by design. Every visitor's browser downloads
# them inside the JavaScript bundle the moment they open the site, so keeping
# them out of the repository would protect nothing. Supabase documents the
# publishable/anon key as safe to expose; Row Level Security is what actually
# protects the data, and every table in this project has it enabled.
#
# NEVER put the `sb_secret_...` / service_role key in this file, or in any
# variable starting with VITE_. Those bypass RLS entirely. They belong only in
# Supabase Edge Function secrets, server-side.
#
# To point the public build at a different Supabase project, change these two.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://wiofmcqvpyixblpbuzcp.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_aUFxovfwd_x-5BJXzikKpA_5AYHyAjO

# Free, keyless map stack - no billing account needed.
VITE_MAP_PROVIDER=maplibre
VITE_GEO_PROVIDER=osm
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
VITE_OSRM_URL=https://router.project-osrm.org

# Starting view before the browser grants location (Colombo).
VITE_DEFAULT_MAP_LAT=6.9271
VITE_DEFAULT_MAP_LNG=79.8612
VITE_DEFAULT_MAP_ZOOM=13

VITE_CURRENCY=LKR
VITE_FARE_BASE=150
VITE_FARE_PER_KM=70
VITE_FARE_PER_MIN=4

# Firebase push is optional and off; Realtime + service-worker notifications
# cover the in-app case with no third-party account.
VITE_FCM_ENABLED=false
