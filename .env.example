# ---------------------------------------------------------------------------
# Ride App environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# Only VITE_-prefixed vars reach the browser - never put a secret in one.
# ---------------------------------------------------------------------------

# === REQUIRED: Supabase ====================================================
# Project Settings -> API in the Supabase dashboard.
# The anon key is safe in the browser: RLS is what protects your data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# === Map provider ==========================================================
# "maplibre" (default) = OpenStreetMap tiles, free, no API key, no credit card.
# "google"             = Google Maps JS API, requires VITE_GOOGLE_MAPS_API_KEY.
VITE_MAP_PROVIDER=maplibre

# Only needed when VITE_MAP_PROVIDER=google.
# Enable: Maps JavaScript API, Geocoding API, Routes API. Restrict by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a styled vector tile source for MapLibre (e.g. MapTiler free tier).
# Leave blank to use the keyless raster OpenStreetMap style.
VITE_MAPLIBRE_STYLE_URL=

# Map starting position when the browser has not yet granted GPS permission.
# Defaults to Colombo, Sri Lanka.
VITE_DEFAULT_MAP_LAT=6.9271
VITE_DEFAULT_MAP_LNG=79.8612
VITE_DEFAULT_MAP_ZOOM=13

# === Geocoding / routing services ==========================================
# "osm" (default) = Nominatim + OSRM public endpoints. Free, rate-limited.
# "google"        = Google Geocoding + Routes (needs the key above).
VITE_GEO_PROVIDER=osm
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org
VITE_OSRM_URL=https://router.project-osrm.org

# === Pricing (display only) ================================================
VITE_CURRENCY=LKR
VITE_FARE_BASE=150
VITE_FARE_PER_KM=70
VITE_FARE_PER_MIN=4

# === Optional: Firebase Cloud Messaging web push ===========================
# Leave ALL of these blank to use the built-in service-worker notifications
# instead (no third-party account required). See README section "Push".
VITE_FCM_ENABLED=false
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY - set these as Supabase Edge Function secrets.
# They must NEVER appear with a VITE_ prefix and never in frontend code.
#   supabase secrets set FCM_SERVICE_ACCOUNT_JSON="$(cat service-account.json)"
# ---------------------------------------------------------------------------
# FCM_SERVICE_ACCOUNT_JSON=
# DISPATCH_TICK_SECRET=
